#Não possui erro Léxico
[dec]
Num1(integer)
Num2(integer)
Num3(integer)
Aux(integer)

[prog]
# Coloca 3 números em ordem crescente
read Num1
read Num2
read Num3
if Num1 > Num2 then
   start
      Aux << 2. 4+3-4+5-6*5-1.6
      Num2 << Num1
      Num1 << Aux
   end 
if Num1 > Num3 and Num2 <= Num4 and Num1 > 3 or Num2 <> Num4 then
   start
      Aux << Num3
      Num3 << Num1
      Num1 << Aux
   end
if Num2 > Num3 then
   start
      Aux<< Num3
      Num3<< Num2
     Num2<<Aux
   end
print Num1
print Num2
print Num3
print "Acabou o programa"

