#Erro Léxico: <=> 

[dec]
Parametro(integer)
Fatorial1123(integer)

[prog]
# Calcula o fatorial de um número inteiro
read Parametro
Fatorial < Parametro
if Parametro = 0 then Fatorial << 1
while Parametro > 1 then
start
Fatorial << Fatorial * (Parametro - 1) 
Parametro << Parametro - 1
end
print Fatorial
print "PPPPPPPdddae"
