#Programa não possui erro léxico

[dec]
Parametro(integer)
Fatorial(float)

[prog]
# ####
read Parametro
Fatorial << Parametro 
if Parametro <> 0 or Parametro < == 0 then Fatorial << 1
while Parametro > 1 then
start
Fatorial << Fatorial * (Parametro - 1) 
Parametro << Parametro - 12.456
end
print Fatorial
print "Oi"
